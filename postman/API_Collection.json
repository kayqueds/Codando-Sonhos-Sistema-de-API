{
  "info": {
    "name": "Sistema de Usuários e Filmes - API Collection",
    "description": "Coleção completa de testes da API para o projeto de QA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Cadastrar Usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@example.com\",\n  \"password\": \"Senha123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "response": [
            {
              "name": "201 - Usuário Criado",
              "status": "Created",
              "code": 201,
              "body": "{\"message\": \"Usuário criado com sucesso.\", \"user\": {\"id\": 1, \"name\": \"João Silva\", \"email\": \"joao@example.com\", \"created_at\": \"2026-05-03T12:00:00\"}}"
            },
            {
              "name": "400 - Validação Falhou",
              "status": "Bad Request",
              "code": 400,
              "body": "{\"errors\": [\"A senha deve ter ao menos 8 caracteres.\"]}"
            },
            {
              "name": "409 - Email Duplicado",
              "status": "Conflict",
              "code": 409,
              "body": "{\"message\": \"Email já cadastrado.\"}"
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@example.com\",\n  \"password\": \"Senha123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": [
            {
              "name": "200 - Login Sucesso",
              "status": "OK",
              "code": 200,
              "body": "{\"access_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\", \"user\": {\"id\": 1, \"name\": \"João Silva\", \"email\": \"joao@example.com\"}}"
            },
            {
              "name": "401 - Credenciais Inválidas",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\"message\": \"Email ou senha inválidos.\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Usuários",
      "item": [
        {
          "name": "Listar Usuários",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          },
          "response": [
            {
              "name": "200 - Sucesso",
              "status": "OK",
              "code": 200,
              "body": "{\"users\": [{\"id\": 1, \"name\": \"João\", \"email\": \"joao@example.com\"}]}"
            },
            {
              "name": "401 - Sem Token",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\"msg\": \"Missing Authorization Header\"}"
            }
          ]
        },
        {
          "name": "Detalhes do Usuário",
