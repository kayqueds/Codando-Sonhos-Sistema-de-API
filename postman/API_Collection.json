            }
          ]
        }
      ]
    },
    {
      "name": "Testes de Segurança",
      "item": [
        {
          "name": "Requisição sem Token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/movies",
              "host": ["{{base_url}}"],
              "path": ["movies"]
            }
          },
          "response": [
            {
              "name": "401 - Acesso Negado",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\"msg\": \"Missing Authorization Header\"}"
            }
          ]
        },
        {
          "name": "Token Inválido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer token.invalido.aqui"
              }
            ],
            "url": {
              "raw": "{{base_url}}/movies",
              "host": ["{{base_url}}"],
              "path": ["movies"]
            }
          },
          "response": [
            {
              "name": "422 - Token Inválido",
              "status": "Unprocessable Entity",
              "code": 422,
              "body": "{\"msg\": \"Invalid token\"}"
            }
          ]
        },
        {
          "name": "Acessar Filme de Outro Usuário",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/movies/999",
              "host": ["{{base_url}}"],
              "path": ["movies", "999"]
            }
          },
          "response": [
            {
              "name": "404 - Não Encontrado",
              "status": "Not Found",
              "code": 404,
              "body": "{\"message\": \"404 Not Found\"}"
            }
          ]
        }
      ]
    }
